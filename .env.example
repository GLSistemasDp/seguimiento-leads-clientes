# ---------------------------------------------------------------------------
# Motor de datos
# ---------------------------------------------------------------------------
# "sheets" (default) guarda todo en una planilla de Google.
# "demo" guarda todo en memoria con datos de ejemplo (sin credenciales).
# "postgres" usa Prisma; la estructura de columnas es identica, asi que migrar
# es copiar la planilla a las tablas y cambiar este valor.
DB_BACKEND="sheets"

# ---------------------------------------------------------------------------
# Google Sheets (necesario con DB_BACKEND="sheets")
# ---------------------------------------------------------------------------
# ID de la planilla: esta en su URL, entre /d/ y /edit
#   https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEETS_ID=""

# Service account de Google Cloud con la API de Sheets habilitada.
# La planilla tiene que estar compartida con este mail, con permiso de Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL="nombre@proyecto.iam.gserviceaccount.com"

# La clave privada del JSON de la service account, en una sola linea y con los
# saltos de linea escapados como \n (copiala tal cual viene en el JSON).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Seguimiento de clientes (con DB_BACKEND="sheets")
# ---------------------------------------------------------------------------
# Planilla del equipo de atencion al cliente (el ID de su URL). Tiene que
# estar compartida con la service account de arriba, con permiso de Editor:
# la app tilda la casilla de RESPUESTA y escribe las OBSERVACIONES.
SEGUIMIENTO_SHEETS_ID=""
# Nombre de la pestana donde esta TablaSeguimiento.
SEGUIMIENTO_HOJA="Seguimiento"
# Primera fila de la planilla a tomar (las anteriores no estan normalizadas).
SEGUIMIENTO_FILA_INICIO="600"
# "sheets" o "demo": permite usar la planilla para el seguimiento aunque el
# resto de la app siga con DB_BACKEND="demo". Vacio = igual que DB_BACKEND.
SEGUIMIENTO_BACKEND=""
# "publico" lee la planilla por su link ("Cualquier persona con el enlace"),
# sin service account. Es solo lectura: lo que se finaliza desde la app queda
# en SEGUIMIENTO_CAMBIOS_ARCHIVO (por defecto .data/seguimiento-cambios.json).
SEGUIMIENTO_ACCESO=""

# ---------------------------------------------------------------------------
# Postgres (solo con DB_BACKEND="postgres")
# ---------------------------------------------------------------------------
# Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# El entorno de prueba abre directamente, sin login ni variables de autenticacion.

# ---------------------------------------------------------------------------
# CRM: IA, resumen diario y portal
# ---------------------------------------------------------------------------
# Clave de la API de Claude para puntuar las solicitudes de alta con IA.
# Sin clave, el puntaje se calcula por reglas y el boton "Evaluar con IA" avisa.
ANTHROPIC_API_KEY=""
# Numero de WhatsApp (con codigo de pais, solo digitos, ej. 5491112345678) al
# que se abre el resumen de cierre del dia. Vacio = WhatsApp pregunta a quien.
RESUMEN_WHATSAPP_NUMERO=""
# URL publica del panel, para cerrar el resumen diario con un link.
APP_URL=""
# Nombre que se muestra en "Bienvenido, ..." hasta integrar el login del portal.
PORTAL_USUARIO=""
# Link a la plataforma web que va en el mail de alta aprobada.
PORTAL_URL=""

# ---------------------------------------------------------------------------
# Cierre del dia por Telegram (boton del Resumen + cron 13:00 y 17:00 ART)
# ---------------------------------------------------------------------------
# Token del bot (@BotFather -> /newbot) y chat_id del grupo de vendedores
# (agregar el bot al grupo y leerlo en https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_VENDEDORES_CHAT_ID=""
# Protege /api/cron/cierre-del-dia. Vercel la manda sola en los crons de vercel.json.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Formularios para clientes y acceso a la intranet
# ---------------------------------------------------------------------------
# Usuario y clave para entrar a la intranet. Con estas dos variables todo pide
# login salvo /formularios/* (reclamo y alta), /api/publico/* y el cron.
# Vacias = la intranet abre sin pedir nada (solo para la demo).
INTRANET_USUARIO=""
INTRANET_PASSWORD=""
# Si los HTML de public/formularios se publican en otro sitio (ej. la web de
# De Pascale), sus origenes separados por coma: https://www.depascale.com.ar
FORMULARIOS_ORIGENES=""
